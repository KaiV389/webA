# Todo lo que no sea un archivo real (css, imágenes) pasa por index.php
#
# Probado en IONOS (nov 2026). Ojo:
#  - IONOS no permite "Options" en .htaccess: provoca error 500.
#  - RewriteBase / es necesario en IONOS.
#  - La redirección a https se activa en el panel de IONOS (SSL → forzar https),
#    no aquí.
RewriteEngine On
RewriteBase /

# Nunca servir archivos ocultos (.env, .git, etc.)
RewriteRule (^|/)\. - [F]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]
